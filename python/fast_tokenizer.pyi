from collections.abc import Sequence

class Tokenizer:
    """Byte-level BPE tokenizer implemented in Rust."""

    @staticmethod
    def train(
        text: str,
        vocab_size: int = 8000,
        special_tokens: Sequence[str] | None = None,
    ) -> Tokenizer: ...
    @staticmethod
    def load(path: str) -> Tokenizer: ...
    @staticmethod
    def from_gpt2_files(vocab_path: str, merges_path: str) -> Tokenizer: ...
    def encode(self, text: str, special_tokens: bool = True) -> list[int]: ...
    def encode_ordinary(self, text: str) -> list[int]: ...
    def encode_batch(self, texts: Sequence[str], num_threads: int = 0) -> list[list[int]]: ...
    def decode(self, ids: Sequence[int]) -> str: ...
    def save(self, path: str) -> None: ...
    def merges(self) -> list[tuple[str, str]]: ...
    def special_tokens(self) -> list[str]: ...
    def token_to_id(self, token: str) -> int | None: ...
    def id_to_token(self, id: int) -> str | None: ...
    @property
    def vocab_size(self) -> int: ...
    def __repr__(self) -> str: ...

__version__: str
